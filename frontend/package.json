{
  "name": "dexa-absensi-frontend",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n employee,hr -c green,cyan \"npm:dev:employee\" \"npm:dev:hr\"",
    "dev:employee": "npm run dev -w employee-web",
    "dev:hr": "npm run dev -w hr-web",
    "build": "npm run build -w employee-web && npm run build -w hr-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.0"
  }
}
