# Copy to .env. HOST values are localhost for npm dev; docker-compose overrides them with service names.

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=dexa
DB_PASSWORD=dexa_secret
DB_DATABASE=dexa_absensi
MYSQL_ROOT_PASSWORD=root_secret

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds; the refresh cookie renews it silently
JWT_ACCESS_EXPIRES_IN=900
# "Trust this device" session length, and the server-side cap for browser-session logins
SESSION_TRUSTED_DAYS=7
SESSION_DEFAULT_HOURS=12
# true when served over HTTPS
COOKIE_SECURE=false

# API gateway: the only HTTP entry point for the frontends
GATEWAY_PORT=3000
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of reverse proxies in front of the gateway (1 behind nginx), so rate limits use the
# visitor's IP. Leave empty when nothing sits in front.
TRUST_PROXY=

# Microservices: TCP, called only by the gateway
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=4001
EMPLOYEE_SERVICE_HOST=localhost
EMPLOYEE_SERVICE_PORT=4002
ATTENDANCE_SERVICE_HOST=localhost
ATTENDANCE_SERVICE_PORT=4003

# Other
UPLOAD_DIR=./uploads
# Place names for check-in locations (OpenStreetMap). false = store the location without a name.
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
APP_TIMEZONE=+07:00
