# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Mode development: service NestJS jalan di laptop -> semua HOST = localhost.
# Mode docker compose: nilai HOST di-override di docker-compose.yml (nama service).

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=dexa
DB_PASSWORD=dexa_secret
DB_DATABASE=dexa_absensi
MYSQL_ROOT_PASSWORD=root_secret

# ===== Auth =====
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=8h

# ===== API Gateway (HTTP, satu-satunya pintu masuk dari frontend) =====
GATEWAY_PORT=3000

# ===== Microservices (TCP, hanya dipanggil oleh gateway) =====
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=4001
EMPLOYEE_SERVICE_HOST=localhost
EMPLOYEE_SERVICE_PORT=4002
ATTENDANCE_SERVICE_HOST=localhost
ATTENDANCE_SERVICE_PORT=4003

# ===== Lain-lain =====
UPLOAD_DIR=./uploads
APP_TIMEZONE=+07:00

# true = tabel dibuat otomatis dari entity (khusus development)
DB_SYNCHRONIZE=true
